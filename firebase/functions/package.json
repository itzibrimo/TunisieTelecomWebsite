{
  "name": "reclamations-tt-functions",
  "description": "Cloud Functions pour l'application Gestion des Réclamations - Tunisie Telecom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts .",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts . --fix",
    "test": "jest",
    "migrate:mockdata": "node scripts/migrate-mockdata.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.7.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "ua-parser-js": "^1.0.37",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
